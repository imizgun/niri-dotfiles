    window-rule {
        geometry-corner-radius 12 // Set every window radius to 20
        clip-to-geometry true
    }

    window-rule {
        match app-id="Alacritty"
        match app-id="com.mitchellh.ghostty"
        match app-id="kitty"

        opacity 0.8

        background-effect {
            blur true
        }
    }

    window-rule {
        match app-id="org.telegram.desktop*"

        opacity 0.85

        background-effect {
            blur true
        }
    }

    window-rule {
        match app-id="org.telegram.desktop*" is-active=true

        opacity 0.8
    }

    // v5 layer-shell namespaces (verified against noctalia-dev/noctalia source:
    // src/shell/{wallpaper,panel,dock,bar,notification,osd,backdrop}/*.cpp)
    layer-rule {
        match namespace="^noctalia-wallpaper$"
        place-within-backdrop true
    }

    layer-rule {
        match namespace="^noctalia-(panel|attached-panel|dock|bar-.*|notification|osd|backdrop)$"
        background-effect {
            xray false
            blur true
        }
        opacity 0.8
    }

    // The v5 settings window is a real toplevel, not a layer surface.
    window-rule {
        match app-id="dev.noctalia.Noctalia"
        open-floating true
    }

